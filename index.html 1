<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ADSOLVA STUDIO — Contact</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --bg:#060608;
  --panel:#0d0d10;
  --red:#e31b23;
  --text:#f5f5f7;
  --muted:#85858d;
  --line:rgba(255,255,255,.1);
  --font:"Plus Jakarta Sans",Arial,sans-serif;
  --heading:"Space Grotesk",Arial,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  min-height:100vh;background:
  radial-gradient(circle at 75% 50%,rgba(227,27,35,.08),transparent 32%),
  #060608;color:var(--text);font-family:var(--font);overflow-x:hidden;
}
a{text-decoration:none;color:inherit}
.page{min-height:100vh;padding:45px 6vw;position:relative}
.page:before{
  content:"";position:fixed;inset:0;pointer-events:none;opacity:.2;
  background-image:linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px);
  background-size:42px 42px;
  mask-image:linear-gradient(to bottom,black,transparent 90%);
}
.nav{
  width:min(1200px,100%);margin:auto;display:flex;justify-content:space-between;align-items:center;
  position:relative;z-index:2;margin-bottom:65px
}
.logo{font:700 1.25rem var(--heading);letter-spacing:1px}
.logo span{display:block;font:600 .5rem var(--font);letter-spacing:3px;color:var(--red);margin-top:4px}
.nav a:last-child{
  border:1px solid var(--line);padding:10px 16px;border-radius:999px;font-size:.72rem;color:#ccc;
}
.nav a:last-child:hover{border-color:var(--red)}
.layout{
  width:min(1200px,100%);margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:18px;position:relative;z-index:1
}
.left,.right{min-width:0}
.left{display:flex;flex-direction:column;gap:14px}
.email,.contact,.calendar,.map{
  border:1px solid var(--line);background:rgba(12,12,15,.95);border-radius:20px;
}
.email{
  min-height:220px;padding:30px;position:relative;overflow:hidden;
  border-color:rgba(227,27,35,.25);
  background:radial-gradient(circle at 100% 100%,rgba(227,27,35,.14),transparent 45%),#0c0c0f;
}
.email:after{content:"";position:absolute;right:0;top:0;width:150px;height:1px;background:var(--red);box-shadow:0 0 20px var(--red)}
.label{font-size:9px;font-weight:800;letter-spacing:2.5px;color:var(--red)}
.email h1{font:700 30px var(--heading);margin:11px 0 8px}
.email p{font-size:11px;color:var(--muted);line-height:1.65;max-width:470px}
.email-row{margin-top:21px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.email-row a{font-size:13px;color:#ff5960;font-weight:700}
button{
  border:1px solid rgba(227,27,35,.35);background:rgba(227,27,35,.06);color:#ccc;
  border-radius:999px;padding:7px 12px;font-size:9px;cursor:pointer
}
button:hover{background:var(--red);color:#fff}
.contact{
  min-height:88px;padding:19px 21px;display:flex;align-items:center;gap:15px;transition:.3s
}
.contact:hover{transform:translateX(4px);border-color:rgba(227,27,35,.3);background:#100b0d}
.icon{
  width:43px;height:43px;border-radius:13px;background:#18181b;border:1px solid var(--line);
  display:grid;place-items:center;color:var(--red);font-size:18px;font-weight:700;flex:none
}
.contact h2{font:600 15px var(--heading);margin-bottom:5px}
.contact span{font-size:12px;color:#ff5960;font-weight:600}

.right{display:flex;flex-direction:column;gap:14px}
.booking{
  display:flex;justify-content:space-between;align-items:end;gap:15px;padding:2px 2px 3px
}
.booking h2{font:600 17px var(--heading);margin-top:6px}
.booking p{font-size:10px;color:var(--muted);margin-top:3px}
.book{
  background:var(--red);padding:10px 15px;border-radius:999px;font-size:10px;font-weight:800;white-space:nowrap;
  box-shadow:0 8px 25px rgba(227,27,35,.2)
}
.book:hover{transform:translateY(-2px)}

.calendar{padding:22px 24px;background:#0b0b0e}
.cal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.cal-head strong{font:600 14px var(--heading)}
.cal-head small{font-size:9px;color:#777}
.cal-head small:before{content:"";display:inline-block;width:5px;height:5px;border-radius:50%;background:var(--red);margin-right:5px}
.week,.days{display:grid;grid-template-columns:repeat(7,1fr);text-align:center}
.week{margin-bottom:10px}
.week span{font-size:8px;color:#666;font-weight:700}
.days{gap:6px 0}
.days button,.days i{width:30px;height:30px;justify-self:center;display:grid;place-items:center;border-radius:50%}
.days button{border:0;background:transparent;color:#707077;font:500 10px var(--font);padding:0}
.days button:hover{background:#222;color:white}
.days .free{background:var(--red);color:white;box-shadow:0 0 18px rgba(227,27,35,.25)}
.days .selected{outline:1px solid rgba(227,27,35,.8);outline-offset:2px}
.map{
  height:245px;position:relative;overflow:hidden;background:#070709
}
.map-title{position:absolute;top:18px;left:22px;z-index:3}
.map-title strong{display:block;font:600 15px var(--heading);margin-top:5px}
.map-title small{font-size:9px;color:#777}
.world{position:absolute;inset:0}
.land{
  position:absolute;opacity:.55;
  background-image:radial-gradient(circle,rgba(145,145,152,.7) 1.7px,transparent 2px);
  background-size:9px 9px;
}
.l1{width:155px;height:75px;left:1%;top:91px;border-radius:55% 40% 50% 42%;transform:rotate(9deg)}
.l2{width:145px;height:105px;left:13%;top:112px;border-radius:45% 55% 42% 50%;transform:rotate(20deg)}
.l3{width:210px;height:105px;left:28%;top:63px;border-radius:48% 55% 44% 50%;transform:rotate(-5deg)}
.l4{width:130px;height:105px;left:49%;top:73px;border-radius:50% 45% 50% 45%;transform:rotate(8deg)}
.l5{width:175px;height:80px;right:7%;top:76px;border-radius:50% 50% 45% 55%;transform:rotate(9deg)}
.l6{width:105px;height:80px;right:2%;top:137px;border-radius:50%}
.pin{
  position:absolute;left:59%;top:50%;width:10px;height:10px;background:#8279ff;border-radius:50%;
  box-shadow:0 0 15px #8279ff
}
.pin:before{
  content:"";position:absolute;inset:-10px;border:1px solid #8279ff;border-radius:50%;
  animation:pulse 2s infinite
}
.pin:after{content:"PAKISTAN";position:absolute;left:17px;top:-5px;color:#aaa5ff;font-size:7px;font-weight:800;letter-spacing:1.5px;white-space:nowrap}
@keyframes pulse{0%{transform:scale(.5);opacity:.8}70%,100%{transform:scale(1.7);opacity:0}}
.toast{
  position:fixed;bottom:25px;left:50%;transform:translate(-50%,20px);opacity:0;
  background:#171216;border:1px solid rgba(227,27,35,.45);border-radius:999px;padding:9px 15px;font-size:10px;transition:.25s;z-index:5
}
.toast.show{opacity:1;transform:translate(-50%,0)}
@media(max-width:800px){
  .page{padding:30px 18px}.nav{margin-bottom:45px}.layout{grid-template-columns:1fr}
}
@media(max-width:500px){
  .booking{align-items:flex-start;flex-direction:column}.book{margin-top:4px}
  .email{padding:24px}.email h1{font-size:27px}
  .calendar{padding:19px 13px}.days button,.days i{width:27px;height:27px}
}
</style>
</head>

